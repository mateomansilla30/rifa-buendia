# Copiá a .env.local para desarrollo (npm run dev). En Easypanel se cargan en la pestaña Environment.
PORT=3000
DATABASE_PATH=/data/rifa.db
ADMIN_USER=admin
ADMIN_PASSWORD=cambiame-por-una-clave-larga
SESSION_SECRET=poné-acá-64-caracteres-al-azar
TZ=America/Buenos_Aires
# Datos de ejemplo (vendedores fede/1111, mateo/2222, sofi/3333 y ~60 ventas). Solo para probar: NO en producción.
# SEED_DEMO=1
# Solo si probás el contenedor por http sin HTTPS (en Easypanel con dominio NO hace falta):
# INSECURE_COOKIES=1
